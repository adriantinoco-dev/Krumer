{
  "name": "krumer",
  "version": "1.2.0",
  "description": "Gerenciador de biblioteca pessoal para leitura de livros e quadrinhos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "library",
    "epub",
    "pdf",
    "reader",
    "electron"
  ],
  "author": {
    "name": "adriantinoco-dev",
    "email": "contato.adriantinoco@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.2.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  },
  "build": {
    "appId": "com.krumer.app",
    "productName": "Krumer",
    "artifactName": "${productName}-${os}-v${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/"
      }
    ],
    "files": [
      "frontend/**/*",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "frontend/assets/Krumer-icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "frontend/assets/Krumer-icon.png",
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Krumer"
    },
    "publish": {
      "provider": "github",
      "owner": "adriantinoco-dev",
      "repo": "Krumer"
    }
  }
}