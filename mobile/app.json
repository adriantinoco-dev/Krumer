{
  "expo": {
    "name": "Krumer",
    "slug": "krumer",
    "displayName": "Krumer",
    "version": "1.3.5",
    "scheme": "krumer",
    "orientation": "portrait",
    "icon": "./assets/Krumer-splash-icon.png",
    "splash": {
      "backgroundColor": "#111111"
    },
    "android": {
      "package": "com.adriantinoco.krumer",
      "versionCode": 3,
      "splash": {
        "backgroundColor": "#111111"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111111"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "./plugins/with-ndk27",
      "./plugins/withInstallPermission",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "4f26c674-76c9-469f-b38a-05c8b6a00234"
      }
    }
  }
}
