# Mobile — Expo + Supabase Auth
# Copie para .env.local e preencha com as chaves públicas do projeto.
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OAuth Client ID do tipo "Web application" no Google Auth Platform.
# É um identificador público; o Client Secret fica somente no Supabase.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-exemplo.apps.googleusercontent.com

# Nunca coloque SUPABASE_SERVICE_ROLE_KEY ou o Client Secret do Google no app.
