{
  "name": "krumer-mobile",
  "version": "0.2.0",
  "private": true,
  "description": "Versao Android do Krumer em React Native",
  "main": "expo/AppEntry.js",
  "scripts": {
    "android": "node scripts/fix-netinfo-gradle9.cjs && node scripts/fix-pdf-webview-range.cjs && expo run:android",
    "postinstall": "node scripts/fix-netinfo-gradle9.cjs && node scripts/fix-pdf-webview-range.cjs && node scripts/prepare-pdf-web-runtime.cjs",
    "prebuild": "expo prebuild && node scripts/fix-netinfo-gradle9.cjs && node scripts/fix-pdf-webview-range.cjs",
    "prepare:pdf-web": "node scripts/prepare-pdf-web-runtime.cjs",
    "start": "expo start",
    "test": "jest",
    "test:epub-runtime": "node scripts/validate-epub-runtime.cjs",
    "test:reading-preferences": "node scripts/validate-reading-preferences.cjs",
    "test:reader-persistence": "node scripts/validate-reader-persistence.cjs",
    "test:pdf-reader": "node scripts/validate-pdf-reader.cjs",
    "test:pdf-gestures": "node scripts/validate-pdf-gestures.cjs",
    "test:pdf-render-pipeline": "node scripts/validate-pdf-render-pipeline.cjs",
    "test:pdf-runtime-resilience": "node scripts/validate-pdf-runtime-resilience.cjs",
    "test:metadata": "node scripts/validate-metadata-service.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-mono": "^0.4.2",
    "@expo-google-fonts/noto-serif": "^0.4.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.12",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-google-signin/google-signin": "16.1.4",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@supabase/supabase-js": "2.112.3",
    "expo": "57.0.15",
    "expo-asset": "~57.0.14",
    "expo-brightness": "^57.0.1",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.14",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-intent-launcher": "~57.0.1",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.2",
    "expo-sqlite": "~57.0.1",
    "jszip": "3.10.1",
    "lucide-react-native": "^1.31.0",
    "pdfjs-dist": "5.5.207",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    }
  }
}